{
  "definitions": [
    {
      "title": "Content Fragments",
      "id": "content-fragments",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Content Fragments",
              "filter": "content-fragments"
            }
          }
        }
      }
    },
    {
      "title": "Content Fragment",
      "id": "content-fragment",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "Content Fragment",
              "model": "content-fragment"
            }
          }
        },
        "aem": {
          "cf": {
            "name": "Article CF",
            "cfModel": "/conf/global/settings/dam/cfm/models/eds-article-model",
            "cfFolder": "/content/dam/ashu-eds-learning/articles",
            "title": "New Content Fragment",
            "description": "New Content Fragment Description",
            "template": {
              "articleTitle": "Article Title",
              "articleDescription": "Article Description",
              "articleBannerPath": ""
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "content-fragment",
      "fields": [
        {
          "component": "aem-content-fragment",
          "name": "reference",
          "label": "Content Fragment Picker",
          "valueType": "string",
          "required": true,
          "variationName": "contentFragmentVariation",
          "validation": {
            "rootPath": "/content/dam/ashu-eds-learning/articles"
          }
        },
        {
          "component": "text",
          "name": "contentFragmentVariation",
          "label": "Selected Variation",
          "value": "",
          "valueType": "string",
          "description": "Persisted variation for publish; leave empty for master.",
          "condition": { "==": [ { "var": "__alwaysFalse" }, true ] }
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "content-fragments",
      "components": [
        "content-fragment"
      ]
    }
  ]
}
